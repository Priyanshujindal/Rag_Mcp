# ==============================================================================
# Production Environment Template – Rag_Mcp
# Generate 64-byte secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ==============================================================================

NODE_ENV=production
PORT=8000
TRUST_PROXY=true
COOKIE_SAMESITE=none

# Frontend URL (exact origin, no trailing slash, no "*")
WEB_ORIGIN=https://app.yourdomain.com
WIDGET_URL=https://api.yourdomain.com/api/v1/public/widget.js

# Web App (apps/web) build-time variables
VITE_MOCK_API=false
VITE_API_URL=https://api.yourdomain.com/api/v1
VITE_EMBED_WIDGET_URL=https://api.yourdomain.com/api/v1/public/widget.js

# Database & Redis
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=Rag_Mcp
REDIS_URL=rediss://default:<password>@<host>:6379

# Internal & Auth Secrets (64-byte hex recommended)
JWT_ACCESS_SECRET=REPLACE_WITH_64_BYTE_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_64_BYTE_HEX
INTERNAL_API_KEY=REPLACE_WITH_64_BYTE_HEX
ENCRYPTION_KEY=REPLACE_WITH_64_BYTE_HEX

# AI Service & LLM Keys
AI_SERVICE_URL=http://ai-service:8001
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Persistent Storage & MCP Process Limits
STORAGE_DIR=/app/storage
MAX_MCP_STDIO_PER_WORKSPACE=5
MCP_IDLE_TIMEOUT_MS=900000

# Optional Observability (Sentry)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
