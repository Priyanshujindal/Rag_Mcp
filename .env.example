# ==============================================================================
# Environment Configuration – Rag_Mcp
# Copy this file to .env and fill in the values.
# NEVER commit .env to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Web Application (apps/web)
# ------------------------------------------------------------------------------

# Base URL for backend REST API endpoints (relative path uses the Vite dev proxy to :8000)
VITE_API_URL=/api/v1

# Real-time WebSocket endpoint for streaming chat completions
VITE_WS_URL=ws://localhost:8000/ws

# Set to "true" to use local mock fixtures without needing a running backend.
# Set to "false" to connect to the live backend API.
VITE_MOCK_API=true

# Host URL for loading the embeddable customer chatbot widget script
VITE_EMBED_WIDGET_URL=http://localhost:5174/widget.js

# Optional: default AI model shown in the model selector
VITE_DEFAULT_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# API Server (apps/api)
# Loaded by apps/api via dotenv from the root .env file.
# ------------------------------------------------------------------------------

# MongoDB Atlas SRV connection string (REQUIRED in all environments; no default).
# How to get this:
#   1. Create a free cluster at https://cloud.mongodb.com
#   2. Create a database user with readWrite on ONLY the Rag_Mcp and Rag_Mcp_test
#      databases (do NOT use the Atlas admin role).
#   3. Under Network Access, add your IP address (do NOT use 0.0.0.0/0).
#   4. Click "Connect" → "Drivers" → copy the SRV string and paste below.
# See docs/atlas-setup.md for step-by-step instructions.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Name of the main application database
MONGODB_DB_NAME=Rag_Mcp

# Name of the isolated test database (MUST end with "_test" and differ from MONGODB_DB_NAME)
MONGODB_TEST_DB_NAME=Rag_Mcp_test

# Redis connection URL (used for job queues and rate-limit state)
REDIS_URL=redis://localhost:6379

# HTTP port the API server listens on
PORT=8000

# "development" | "production" | "test"
NODE_ENV=development

# Allowed origin for CORS (comma-separated list supported, credentials allowed, never "*")
WEB_ORIGIN=http://localhost:3000

# URL where the embeddable widget is hosted
WIDGET_URL=http://localhost:5174

# Trust reverse proxy headers (e.g. X-Forwarded-For)
# Set to true (or number of hops, e.g. 1) ONLY when running behind a trusted reverse proxy (Nginx, Cloudflare)
TRUST_PROXY=false

# Rate limiting for auth routes
# POST /login & /register per IP limit
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
# POST /refresh per IP limit (generous for page reloads / tabs)
AUTH_REFRESH_RATE_LIMIT_MAX=60
# POST /login cross-IP limit per email (failed attempts only)
LOGIN_EMAIL_RATE_LIMIT_MAX=20
LOGIN_EMAIL_RATE_LIMIT_WINDOW_MINUTES=60

# Refresh token race grace window in seconds (tolerates multi-tab & React StrictMode concurrent refreshes)
REFRESH_GRACE_SECONDS=10

# Require live Atlas connection during tests (fails hard if unreachable when true; defaults to graceful skip)
REQUIRE_LIVE_TESTS=false

# Refresh token cookie SameSite policy: "lax" (default) | "strict" | "none"
# Note: "none" requires HTTPS/Secure; "strict" prevents cookies across different top-level domains.
COOKIE_SAMESITE=lax

# JWT & Internal secrets – in production these MUST be at least 32 characters, cannot contain "change_me",
# cannot start with "dev_", and access secret must differ from refresh secret.
# Generate strong secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_64_BYTE_HEX_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_64_BYTE_HEX_REFRESH_SECRET
INTERNAL_API_KEY=REPLACE_WITH_64_BYTE_HEX_INTERNAL_KEY

# Token lifetimes in seconds
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800

# Internal service communication
AI_SERVICE_URL=http://localhost:8001

# Vector embedding dimensions (must match the model used by the ai-service)
# Default 384 matches BAAI/bge-small-en-v1.5; use 1536 for text-embedding-3-small
EMBEDDING_DIMENSIONS=384

# Workspace quotas (enforced on create; 0 = unlimited)
MAX_KBS_PER_WORKSPACE=10
MAX_SOURCES_PER_KB=50
MAX_UPLOAD_MB=20

# ------------------------------------------------------------------------------
# AI Service (services/ai-service)
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
HYBRID_STRATEGY=auto
RERANKER=none
CRAWL_MAX_PAGES=50
CRAWL_MAX_DEPTH=3
MAX_FILE_MB=10
MAX_CHUNKS_PER_WORKSPACE=5000
ESTIMATED_DB_CAPACITY_MB=400
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# File Generation / Artifact Storage (apps/api)
# ------------------------------------------------------------------------------
# Directory where generated artifact files are stored (relative to apps/api CWD)
# Change to an absolute path or object-storage mount in production.
STORAGE_DIR=storage/artifacts

